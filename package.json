{
  "name": "sahara-perfume",
  "version": "2.0.0",
  "private": true,
  "description": "SAHARA — katalog haute parfumerie dengan etalase publik dan panel admin, dilengkapi backend Node.js tanpa dependensi dan database SQLite.",
  "main": "backend/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node backend/index.js",
    "dev": "node backend/index.js",
    "serve": "node server.js",
    "build:cf": "node scripts/build-frontend.js",
    "seed:cf": "node scripts/generate-seed-migration.js",
    "cf:dev": "npm --prefix cf run dev",
    "cf:db": "npm --prefix cf run db:remote",
    "deploy": "npm --prefix cf run deploy"
  }
}
